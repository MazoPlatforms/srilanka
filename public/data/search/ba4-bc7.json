[[" புங்குடுதீவு ஸ்ரீ இராஜ ராஜேஸ்வரி அம்பாள் தேவஸ்தானம்\\n- கண்ணகை அம்மன் ஆலயம் ",79.83111,9.58127,"6WPWV63DKS9RA9EYZ21HKWSE28","0003",8],["Batticaloa - மீன்பாடும் தேன் நாடு",81.696525,7.720135,"1TYQMXY93N8RT8WQ32XY70XKZP","0001",3],["Karai -  சிவகாமி அம்பிகா சமேத ஸ்ரீ சிதம்பரேஸ்வர் தேவஸ்தானம்",79.871577,9.752168,"6G8YF8RX2K9KMS4HTPQ0KSXECF","0003",8],["Nachimar Kovil- அருள் மிகு நாச்சிமார் தேவஸ்தானம்- புங்குடுதீவு",79.8,9.58333,"5XMXTDV6N98KZT2D9G7PZM1MRR","0002",8],["அருள்மிகு மிருசுவில் மன்னன்குறிச்சி தான்தோன்றிக்கந்தசுவாமி தேவஸ்தானம்",80.268,9.69967,"3FFHD3NYMJ8J09WH0N7H5MW4GT","0002",8],["அருள்மிகு ஸ்ரீ கதிரேசப் பெருமான் தேவஸ்தானம் தலவாக்கலை",80.661095,6.939112,"00VYW5KN858XH9D5EN5NBPBF01","0001",19],["அருள்மிகு ஸ்ரீ முத்துக்குமார சுவாமி தேவஸ்தானம் Sri Muthukkumaraswami Temple",81.230797,8.573988,"3K5G8T6CAE9YPTR208903STS1Q","0001",23],["ஆனைப்பந்தி ஶ்ரீ சித்தி விக்கினேஸ்வரர் தேவஸ்த்தானம், மட்டக்களப்பு.",81.694031,7.706062,"1W0TNFYB588SMVV0PYFHF85W4D","0001",3],["இருபாலை கற்பகப்  பிள்ளையார் தேவஸ்தானம்",80.050603,9.688784,"5SBS1EDHKH94ST09Y9FAHCBDHP","0002",8],["ஈச்சமோட்டை கலட்டிப்புலம் ஸ்ரீ ஞானவைரவர் தேவஸ்தானம்",80.031763,9.653645,"39WKDPXWK9992S2MASV8N8FJ2V","0002",8],["ஊற்றங்கரை சித்தி விநாயகர் தேவஸ்தானம்",80.8167,9.26667,"2DDKJKCBQS9CTSC8NSRYD3AW7H","0001",18],["களுவாஞ்சிக்குடி ஸ்ரீ மகா விஷ்ணு தேவஸ்தானம்",81.764145,7.63301,"7QTPYW5JRZ8TBB308KTBY8CGQ9","0002",3],["சாவடை ஶ்ரீ முத்துமாரி அம்மன் தேவஸ்தானம்",80.01898,9.65879,"0R4BGA605B80RBHZNPK8AE194D","0001",8],["திரு. வீரகத்திப் பிள்ளையார் தேவஸ்தானம்- மடத்தடி திருக்கோணமலை",81.22673,8.581976,"5HREMEMH9V8069HM015ZWEANED","0002",23],["தேற்றாத்தீவு கொம்புச்சந்திப் பிள்ளையார் கோவில்.",81.786614,7.559195,"4JAP0D1CQ19X4T08R6DD0GSH6R","0001",3],["தேற்றாத்தீவு தேனுகா கலைக்கழகம்",81.785633,7.562063,"2ZS6DXMXXY9AT8HV5PGG00MK9C","0001",3],["நீ தேடும் தெய்வம்",81.698446,7.713126,"5A4ENVKN6D9DRSS66MM6BC7W5J","0002",3],["பண்டாரக்குளம் மருதளவு பிள்ளையார் தேவஸ்தானம்",80.03302,9.676384,"1NBEZ45GJW9DERYDQ254G0PX2C","0001",8],["பா