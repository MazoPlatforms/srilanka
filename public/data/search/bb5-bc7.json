[["கல்வயல் வேதவனப் பிள்ளையார்",80.164129,9.66919,"0YNFYYVJJX94A9VN9FYDVX6KFA","0001",8],["தென்மட்டுவில் வேரக்கேணி கந்தசுவாமி திருக்கோவில்",80.15,9.65,"27AHPZ9CVG8DVVBXXEX8K6R7BG","0001",8],["புளியந்தீவு ஶ்ரீ சித்திர வேலாயுத சுவாமி ஆலயம் மட்டக்களப்பு ",81.69835,7.73767,"1D6SNTJ8D39FVR826234BAFWYZ","0001",3],["வண்ணை வேங்கடேச வரதராஜப் பெருமாள் தேவஸ்தானம். யாழ்ப்பாணம்",80.01554,9.670609,"1NM80X5EP29NE8JKPQ8P7ZF3KM","0001",8],["வேலணை பெருங்குளம் அருள்மிகு முத்துமாரி அம்மன் திருக் கோவில் ",79.90328,9.627974,"4BS74P5DS78A0TN0243KCW5TFQ","0002",8],["வேலணை வடக்கு இலந்தைவனப்பதி ஸ்ரீ சித்தி விநாயகர் ஆலயம்",79.904023,9.649556,"4TBJWJFBH996MTPPS9FTKNYEG6","0002",8],["வேலன்குளம் ",80.31894,8.78301,"3QP1YYRXEW92FB3HSS2KEYS12C","0001",24],["வேலோடிய மலை முருகன் ஆலயம்",81.504665,7.782534,"63B04VYV8C87STP356CFE3K9NA","0002",3]]